# Server Port (Render sets this automatically; for local development defaults to 8068)
PORT=8068

# Environment Mode ('production' or 'development')
NODE_ENV=production

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas, ensure Network Access allows 0.0.0.0/0 (anywhere)
dbUri=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/blogmate?retryWrites=true&w=majority

# JWT Secret key for authentication tokens
jwt_secret=your_super_secret_jwt_key_here

# Frontend URL (e.g., deployed Vercel/Netlify URL) for CORS and cookie sharing
CLIENT_URL=https://your-frontend-domain.vercel.app
